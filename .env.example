# Everything runs locally — no API keys required.
DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5432/agentic
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434
JWT_SECRET=dev-secret-change-me

# Model selection: leave empty to auto-detect hardware tier (see models.yaml)
MODEL_TIER=
CHAT_MODEL=

# Optional USD-equivalent cost estimate for cloud comparison (0 = disabled)
PRICE_PER_MTOKEN=0

# Langfuse (make observability). The compose auto-provisions these dev keys;
# leave empty to disable LLM tracing.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev

# OTel collector (make observability); empty = traces not exported
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
